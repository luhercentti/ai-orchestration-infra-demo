# ── LLM provider (pick one, or leave blank for heuristic-only mode) ──────────
#
# Option 1: No LLM — agents use keyword heuristics. Works offline, no cost.
#   Leave OPENAI_API_KEY empty (default).
#
# Option 2: OpenAI — real intelligence, ~$0.001/request with gpt-4o-mini.
#   OPENAI_API_KEY=sk-...
#   OPENAI_MODEL=gpt-4o-mini
#
# Option 3: Ollama — fully local, free, no internet required.
#   brew install ollama && ollama pull llama3.2 && ollama serve
#   OPENAI_API_KEY=ollama
#   OPENAI_MODEL=llama3.2
#   OLLAMA_HOST=http://host.docker.internal:11434/v1
#
# ── Active values (edit these) ───────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_HOST=http://host.docker.internal:11434/v1
DATABASE_URL=postgresql://langgraph:langgraph@localhost:5432/langgraph
REDIS_URL=redis://localhost:6379/0

# Optional — tracing is a no-op if these are unset. Use https://cloud.langfuse.com
# or a self-hosted instance (see https://langfuse.com/self-hosting).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
